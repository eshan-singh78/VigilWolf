# Backend Configuration
MONITORING_DATA_DIR=/app/monitoring_data
DATABASE_URL=sqlite:////app/monitoring_data/vigilwolf.db

# SECURITY CRITICAL: Change this in production. Empty = no auth in dev, required in production.
API_KEY=change-me-in-production

# Environment (development | production)
ENVIRONMENT=development

# Frontend proxy (server-side only, never exposed to browser)
BACKEND_URL=http://localhost:8000

# Docker Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Restrict to known hosts in production
TRUSTED_HOSTS=localhost,127.0.0.1
# Always redirect HTTP to HTTPS in production
FORCE_HTTPS=true

# Rate Limiting (requests per minute, 0 = disabled)
RATE_LIMIT_PER_MINUTE=60

# Optional Redis (for distributed rate limiting and caching)
# REDIS_URL=redis://localhost:6379/0

# Observability
ENABLE_PROMETHEUS=true
